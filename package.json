{
  "name": "multi-gateway-platform",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "cd frontend && npm run build && cd ../backend && npm run build",
    "dev": "concurrently \"cd frontend && npm run dev\" \"cd backend && npm run dev\"",
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:security": "jest backend/tests/security.test.ts --testTimeout=30000 --coverage --coverageReporters=text-summary",
    "loadtest:ci": "npx artillery run loadtest/artillery.yml -o loadtest/report.json",
    "health-check": "node scripts/pre-deploy-health-check.js",
    "validate-deploy": "node scripts/post-deploy-validation.js",
    "rollback": "node scripts/rollback-deployment.js",
    "deploy:local-test": "npm run health-check && echo 'Health checks passed!'",
    "ci:setup": "echo 'Run scripts/setup-github-secrets.sh to configure GitHub Secrets'",
    "ci:validate": "gh workflow run ci-cd.yml --ref main",
    "ci:logs": "gh run list --workflow=ci-cd.yml --limit 5",
    "verify:setup": "node loadtest/verify-setup.js",
    "demo": "node loadtest/run-demo.js",
    "docker:up": "docker-compose up --build -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:restart": "docker-compose down && docker-compose up --build -d",
    "docker:clean": "docker-compose down -v",
    "dev:docker": "docker-compose up --build",
    "db:migrate": "cd commerce-web && npx prisma migrate dev",
    "db:migrate:deploy": "cd commerce-web && npx prisma migrate deploy",
    "db:seed": "cd commerce-web && npm run seed",
    "db:reset": "cd commerce-web && npx prisma migrate reset --force && npm run seed",
    "test:e2e": "cd commerce-web && npm run test:e2e",
    "test:webhooks": "cd commerce-web && npm run test:webhooks",
    "verify:docker": "node scripts/verify-docker-startup.js",
    "verify:security-headers": "node scripts/validate-security-headers.js",
    "demo:security": "node scripts/demo-security.js",
    "demo:storage": "node scripts/demo-storage.js",
    "cleanup:retention": "node scripts/retention-cleanup.js",
    "proof:audit-logs": "node scripts/proof-audit-logs.js",
    "verify:audit-logs": "node scripts/verify-audit-logs.js",
    "verify:rate-limiting": "node scripts/verify-rate-limiting.js",
    "verify:admin-protection": "node scripts/verify-admin-protection.js",
    "verify:secrets-hygiene": "node scripts/verify-secrets-hygiene.js",
    "verify:order-status-ui": "node scripts/verify-order-status-ui.js",
    "setup:supabase": "node scripts/setup-supabase.js",
    "demo:preview": "node scripts/demo-preview.js",
    "test:security": "node scripts/test-security.js",
    "verify:rate-limiter": "node scripts/verify-rate-limiter.js",
    "verify:pagination": "node scripts/verify-pagination.js",
    "demo:logs": "node scripts/demo-logs.js",
    "verify:health": "node scripts/verify-health.js",
    "demo:security-center": "node scripts/demo-security-center.js",
    "test:rate-limit": "node scripts/test-rate-limit-store.js",
    "jobs:dry-run": "node scripts/run-jobs.js --dry-run",
    "jobs:run": "node scripts/run-jobs.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ransiluni2003/multi-gateway-platform.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Ransiluni2003/multi-gateway-platform/issues"
  },
  "homepage": "https://github.com/Ransiluni2003/multi-gateway-platform#readme",
  "dependencies": {
    "@opentelemetry/auto-instrumentations-node": "^0.67.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.208.0",
    "@opentelemetry/resources": "^2.2.0",
    "@opentelemetry/sdk-node": "^0.208.0",
    "@opentelemetry/semantic-conventions": "^1.38.0",
    "@supabase/supabase-js": "^2.89.0",
    "amqplib": "^0.10.9",
    "axios": "^1.13.2",
    "bullmq": "^5.66.4",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "ioredis": "^5.8.2",
    "mongoose": "^9.1.1",
    "uuid": "^13.0.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
